---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Sidebar from '@/components/astro/layout/Sidebar.astro'
import ScrollToTop from '@/components/react/layout/ScrollToTop'

import BlockAccordion from '@/components/react/layout/BlockAccordion'
import BookViewport from '@/components/react/layout/BookViewport'
import { WelcomeModal } from '@/components/react/layout/WelcomeModal'
import { BLOCK_ACCENTS } from '@/lib/constants'

import Capa from '@/components/astro/capitulos/Capa.astro'
import Expediente from '@/components/astro/capitulos/Expediente.astro'
import Sumario from '@/components/astro/capitulos/Sumario.astro'
import Apresentacao from '@/components/astro/capitulos/Apresentacao.astro'
import Planejamento from '@/components/astro/capitulos/Planejamento.astro'
import Fundamentos from '@/components/astro/capitulos/Fundamentos.astro'
import Modelos from '@/components/astro/capitulos/Modelos.astro'
import QuemRealiza from '@/components/astro/capitulos/QuemRealiza.astro'

import Premissa from '@/components/astro/capitulos/Premissa.astro'
import Metodo from '@/components/astro/capitulos/Metodo.astro'
import Aplicacao from '@/components/astro/capitulos/Aplicacao.astro'
import Populacao from '@/components/astro/capitulos/Populacao.astro'
import Renda from '@/components/astro/capitulos/Renda.astro'
import Trabalho from '@/components/astro/capitulos/Trabalho.astro'
import Regioes from '@/components/astro/capitulos/Regioes.astro'
import Vulnerabilidade from '@/components/astro/capitulos/Vulnerabilidade.astro'
import Transporte from '@/components/astro/capitulos/Transporte.astro'
import Cras from '@/components/astro/capitulos/Cras.astro'
import Justificativa from '@/components/astro/capitulos/Justificativa.astro'
import Proposta from '@/components/astro/capitulos/Proposta.astro'
import Anexos from '@/components/astro/capitulos/Anexos.astro'
import ContraCapa from '@/components/astro/capitulos/ContraCapa.astro'

const b = BLOCK_ACCENTS
---
<BaseLayout>
  <Sidebar />
  <ScrollToTop client:idle />
  <BlockAccordion client:idle />
  <BookViewport client:load />
  <WelcomeModal client:load />

  <div id="main-content" class="max-w-4xl mx-auto my-8 px-4 md:px-8 space-y-4 md:space-y-6">
    <Capa />
    <Expediente />
    <Sumario />
    <Apresentacao />
    <Planejamento />
    <Fundamentos />
    <Modelos />
    <QuemRealiza />

    <div class="flex justify-center no-print">
      <button id="toggle-all-blocks" class="flex items-center gap-2 px-4 py-2 text-sm font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors max-md:min-h-[44px] max-md:py-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>
        Recolher todos
      </button>
    </div>

    <!-- ======= TRANSIÇÃO: DA TEORIA À PRÁTICA ======= -->
    <div class="rounded-xl border border-institucional-blue/30 bg-institucional-lightBlue dark:bg-blue-900/20 p-6">
      <p class="text-xs font-bold uppercase tracking-widest text-institucional-blue dark:text-institucional-blue/90 mb-2">Como vai funcionar o exemplo prático</p>
      <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">A partir daqui, você acompanhará um <strong>exemplo prático de Diagnóstico Socioterritorial</strong>, aplicado passo a passo ao município de <strong>Silva Jardim (RJ)</strong>, com as mesmas ferramentas simples (Excel, Word e I.A.) disponíveis às equipes do SUAS. A dinâmica é didática: cada bloco parte de uma <strong>pergunta orientadora</strong>, analisa os dados e chega a uma conclusão — sempre mostrando como o mesmo raciocínio pode ser reproduzido em qualquer município.</p>
      <h4 class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-4 mb-2">As 5 etapas do exemplo:</h4>
      <ol class="space-y-2 text-sm text-slate-600 dark:text-slate-400 list-none">
        <li class="flex items-start gap-3"><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-institucional-blue text-white text-xs font-bold flex-shrink-0 mt-0.5">1</span><span><strong class="text-slate-800 dark:text-slate-200">Problema:</strong> verificamos se os equipamentos do SUAS estão onde a pobreza está ou apenas onde a malha urbana é mais consolidada.</span></li>
        <li class="flex items-start gap-3"><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-institucional-blue text-white text-xs font-bold flex-shrink-0 mt-0.5">2</span><span><strong class="text-slate-800 dark:text-slate-200">Perfil de Renda:</strong> identificamos quem é e onde está o público prioritário da Proteção Social Básica no CadÚnico.</span></li>
        <li class="flex items-start gap-3"><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-institucional-blue text-white text-xs font-bold flex-shrink-0 mt-0.5">3</span><span><strong class="text-slate-800 dark:text-slate-200">Acessibilidade e Transporte:</strong> medimos quanto tempo e dinheiro o usuário gasta para chegar até o CRAS.</span></li>
        <li class="flex items-start gap-3"><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-institucional-blue text-white text-xs font-bold flex-shrink-0 mt-0.5">4</span><span><strong class="text-slate-800 dark:text-slate-200">Capacidade vs. Demanda:</strong> comparamos a produção da equipe (RMA) com a capacidade instalada e a vulnerabilidade do território.</span></li>
        <li class="flex items-start gap-3"><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-institucional-blue text-white text-xs font-bold flex-shrink-0 mt-0.5">5</span><span><strong class="text-slate-800 dark:text-slate-200">Proposta de Solução:</strong> com base nos dados, definimos a decisão de gestão mais eficiente e sem aumento de custos.</span></li>
      </ol>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-4">Ao final de cada bloco, uma conclusão resume o que os dados revelaram no exemplo — e o mesmo método pode ser aplicado ao seu município.</p>
    </div>

    <!-- ======= BLOCO 1: Problema ======= -->
    <div data-block-group="bloco-1">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-institucional-blue"></div>
          <span class="text-xs font-bold text-institucional-blue uppercase tracking-widest">Bloco 1 — Problema</span>
        </div>
      </div>
      <div data-block-content="bloco-1" class="space-y-6">
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <Premissa />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <Metodo />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <Aplicacao />
        </section>
      </div>
    </div>

    <!-- ======= BLOCO 2: Perfil de Renda ======= -->
    <div data-block-group="bloco-2">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-institucional-green"></div>
          <span class="text-xs font-bold text-institucional-green uppercase tracking-widest">Bloco 2 — Perfil de Renda</span>
        </div>
      </div>
      <div data-block-content="bloco-2" class="space-y-6">
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.planejamento.border} transition-all hover:shadow-lg`}>
          <Populacao />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.planejamento.border} transition-all hover:shadow-lg`}>
          <Renda />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.planejamento.border} transition-all hover:shadow-lg`}>
          <Trabalho />
        </section>
      </div>
    </div>

    <!-- ======= BLOCO 3: Acessibilidade e Transporte ======= -->
    <div data-block-group="bloco-3">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full" style="background-color: ${b.reprogramacao.hex}"></div>
          <span class="text-xs font-bold ${b.reprogramacao.color} uppercase tracking-widest">Bloco 3 — Acessibilidade e Transporte</span>
        </div>
      </div>
      <div data-block-content="bloco-3" class="space-y-6">
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.reprogramacao.border} transition-all hover:shadow-lg`}>
          <Regioes />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.reprogramacao.border} transition-all hover:shadow-lg`}>
          <Vulnerabilidade />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.reprogramacao.border} transition-all hover:shadow-lg`}>
          <Transporte />
        </section>
      </div>
    </div>

    <!-- ======= BLOCO 4: Capacidade vs. Demanda ======= -->
    <div data-block-group="bloco-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full" style="background-color: ${b.controle.hex}"></div>
          <span class="text-xs font-bold ${b.controle.color} uppercase tracking-widest">Bloco 4 — Capacidade vs. Demanda</span>
        </div>
      </div>
      <div data-block-content="bloco-4" class="space-y-6">
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.controle.border} transition-all hover:shadow-lg`}>
          <Cras />
        </section>
      </div>
    </div>

    <!-- ======= BLOCO 5: Proposta de Solução ======= -->
    <div data-block-group="bloco-5">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-institucional-blue"></div>
          <span class="text-xs font-bold text-institucional-blue uppercase tracking-widest">Bloco 5 — Proposta de Solução</span>
        </div>
      </div>
      <div data-block-content="bloco-5" class="space-y-6">
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <Justificativa />
        </section>
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <Proposta />
        </section>
      </div>
    </div>

    <section class="bg-white dark:bg-slate-800 shadow-md rounded-xl p-6 md:p-10 print:shadow-none print:rounded-none transition-all hover:shadow-lg">
      <Anexos />
    </section>

    <section class="bg-white dark:bg-slate-800 shadow-md rounded-xl p-0 overflow-hidden print:shadow-none print:rounded-none">
      <ContraCapa />
    </section>
  </div>
</BaseLayout>
